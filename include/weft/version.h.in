#ifndef WEFT_VERSION_H
#define WEFT_VERSION_H

#define WEFT_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define WEFT_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define WEFT_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define WEFT_VERSION_STRING "@PROJECT_VERSION@"

#define WEFT_VERSION_NUM \
    (WEFT_VERSION_MAJOR * 10000 + WEFT_VERSION_MINOR * 100 + WEFT_VERSION_PATCH)

#define WEFT_VERSION_AT_LEAST(maj, min, pat) \
    (WEFT_VERSION_NUM >= ((maj) * 10000 + (min) * 100 + (pat)))

#endif
